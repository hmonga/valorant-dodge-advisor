# Copy to .env and adjust.

# Your Valorant region: na, eu, ap, kr, latam, br
VALO_REGION=na

# Set to 1 to run with fake lobby data (no game required) so you can see the UI.
# Set to 0 to read your real live lobby (Valorant must be running).
VALO_MOCK=1

# How many recent competitive matches to sample for "form".
VALO_RECENT=10
